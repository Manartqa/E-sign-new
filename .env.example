# Base URLs
NEXT_PUBLIC_API_BASE_URL=https://api-dev.gov.th/v1

# Frontend-only phase: serve everything from src/mocks.
# While this is true the only account that can sign in is
#   manart.pa@smartalliance.co.th / P@ssw0rd   (see src/lib/auth.ts)
NEXT_PUBLIC_USE_MOCK=true

# Authentication
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ── SSO (OAuth2 Authorization Code + OIDC) ────────────────────────────────
# Server only. Endpoints are fixed paths under OIDC_ISSUER (see src/lib/sso.ts).
# The SSO admin must register this app's client with
#   redirect URI             {NEXT_BASE_URL}/api/auth/callback/sso
#   post-logout redirect URI {NEXT_BASE_URL}/login
NEXT_PUBLIC_SSO_ENABLED=false
OIDC_ISSUER=http://sso.example.local/sso-auth-server
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPE=openid profile email

# ── basePath ──────────────────────────────────────────────────────────────
# Leave both empty to serve at the root; otherwise e.g. /e-sign (same value in
# both). NEXT_BASE_PATH is read at build time by next.config.ts — rebuild after
# changing it. The session cookie is named and scoped after it.
NEXT_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
# Full public URL incl. basePath, no trailing slash
NEXT_BASE_URL=http://localhost:3000
# NextAuth: NEXT_BASE_URL + /api/auth when a basePath is set
#   e.g. NEXTAUTH_URL=https://host/e-sign/api/auth
# How many session-cookie chunks logout clears (optional, default 10)
SESSION_COOKIE_CHUNKS=10

# How long list/report filters are remembered in the browser (unit: minute | hour | day)
NEXT_PUBLIC_SEARCH_PERSIST_EXPIRE_NUM=1
NEXT_PUBLIC_SEARCH_PERSIST_UNIT=day
