# Base URLs
NEXT_PUBLIC_API_BASE_URL=https://api-dev.gov.th/v1

# Frontend-only phase: serve everything from src/mocks.
# While this is true the only account that can sign in is
#   manart.pa@smartalliance.co.th / P@ssw0rd   (see src/lib/auth.ts)
NEXT_PUBLIC_USE_MOCK=true

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── SSO (OAuth2 Authorization Code + OIDC) ────────────────────────────────
# Auth server discovered at http://192.168.33.160:6601/sso-auth-server
# The SSO admin must register this app's client with the EXACT callback URL
#   {NEXTAUTH_URL}/api/auth/callback/sso
# and, for logout, the post-logout redirect  {NEXTAUTH_URL}/login
NEXT_PUBLIC_SSO_ENABLED=false
SSO_ISSUER=http://192.168.33.160:6601/sso-auth-server
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# roles = the claim used for permission gating later
SSO_SCOPES=openid profile email roles
